# Browser-visible API base. Direct local mode may use the backend origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional server-only same-origin proxy target. When set, use
# NEXT_PUBLIC_API_URL=http://localhost:3001/api above and the Next server maps
# /api/* to this fixed backend origin. Do not use NEXT_PUBLIC_ for this value.
# NEXT_API_UPSTREAM_URL=http://localhost:3000
