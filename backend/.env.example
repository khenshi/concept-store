# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/concept_store?schema=public"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# Authentication (use a unique cryptographically random value of at least 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# API documentation (defaults to true outside production and false in production)
SWAGGER_ENABLED=true
