# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# PostgreSQL
# Runtime API: use the provider's pooled endpoint (Neon hostname contains -pooler).
DATABASE_URL="postgresql://app:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Prisma CLI/migrations: use the direct endpoint. It is not read by PrismaService.
DIRECT_DATABASE_URL="postgresql://migrator:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# Authentication (use a unique cryptographically random value of at least 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# API documentation (defaults to true outside production and false in production)
SWAGGER_ENABLED=true
