generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  organizationMemberships         OrganizationMembership[]
  sentOrganizationInvitations     OrganizationInvitation[]         @relation("InvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[]         @relation("InvitationAcceptor")
  sessions                        UserSession[]
  inventoryMovements              InventoryMovement[]
  salesAsCashier                  Sale[]                           @relation("SaleCashier")
  voidedSales                     Sale[]                           @relation("SaleVoider")
  confirmedPayments               Payment[]                        @relation("PaymentConfirmer")
  calculatedSettlements           MerchantSettlement[]             @relation("SettlementCalculator")
  reviewedSettlements             MerchantSettlement[]             @relation("SettlementReviewer")
  approvedSettlements             MerchantSettlement[]             @relation("SettlementApprover")
  merchantFinanceEntries          MerchantFinanceEntry[]           @relation("MerchantFinanceEntryCreator")
  recordedPayouts                 MerchantPayout[]                 @relation("PayoutRecorder")
  completedRefunds                SaleRefund[]                     @relation("RefundCompleter")
  settlementAuditEvents           SettlementAuditEvent[]           @relation("SettlementAuditActor")
  merchantReceivableTransactions  MerchantReceivableTransaction[]  @relation("MerchantReceivableTransactionRecorder")
  agreementPrepaymentTransactions AgreementPrepaymentTransaction[] @relation("AgreementPrepaymentTransactionRecorder")

  @@index([deletedAt])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  acceptedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            OrganizationMembership[]
  branches               Branch[]
  merchants              Merchant[]
  spaces                 Space[]
  merchantAgreements     MerchantAgreement[]
  products               Product[]
  inventory              Inventory[]
  inventoryMovements     InventoryMovement[]
  invitations            OrganizationInvitation[]
  sales                  Sale[]
  saleItems              SaleItem[]
  payments               Payment[]
  settlements            MerchantSettlement[]
  settlementTerms        SettlementTermSnapshot[]
  settlementSaleItems    SettlementSaleItem[]
  merchantFinanceEntries MerchantFinanceEntry[]
  merchantPayouts        MerchantPayout[]
  saleRefunds            SaleRefund[]
  saleRefundItems        SaleRefundItem[]
  settlementRefundItems  SettlementRefundItem[]
  settlementAuditEvents  SettlementAuditEvent[]
  merchantReceivables    MerchantReceivable[]
  receivableTransactions MerchantReceivableTransaction[]
  receivableAllocations  SettlementReceivableAllocation[]
  financeAccruals        MerchantFinanceAccrual[]
  agreementSpaces        MerchantAgreementSpace[]
  agreementPrepayments   AgreementPrepayment[]
  prepaymentTransactions AgreementPrepaymentTransaction[]
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String?
  countryCode    String   @db.Char(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchants    MerchantBranch[]
  spaces       Space[]
  inventory    Inventory[]
  movements    InventoryMovement[]
  sales        Sale[]
  saleRefunds  SaleRefund[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantAccount MerchantAccount?

  @@id([organizationId, userId])
  @@index([userId])
}

model Merchant {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String
  email          String
  phone          String
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization           Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches               MerchantBranch[]
  spaceAssignments       SpaceAssignment[]
  agreements             MerchantAgreement[]
  products               Product[]
  saleItems              SaleItem[]
  settlements            MerchantSettlement[]
  settlementTerms        SettlementTermSnapshot[]
  settlementSaleItems    SettlementSaleItem[]
  merchantFinanceEntries MerchantFinanceEntry[]
  payouts                MerchantPayout[]
  refundItems            SaleRefundItem[]
  settlementRefundItems  SettlementRefundItem[]
  merchantReceivables    MerchantReceivable[]
  receivableTransactions MerchantReceivableTransaction[]
  receivableAllocations  SettlementReceivableAllocation[]
  financeAccruals        MerchantFinanceAccrual[]
  account                MerchantAccount?
  agreementPrepayments   AgreementPrepayment[]
  prepaymentTransactions AgreementPrepaymentTransaction[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model MerchantAccount {
  organizationId String
  userId         String
  merchantId     String
  createdAt      DateTime @default(now())

  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  merchant   Merchant               @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([organizationId, userId])
  @@unique([merchantId, organizationId])
  @@index([organizationId, merchantId])
}

model MerchantBranch {
  organizationId String
  merchantId     String
  branchId       String
  createdAt      DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([merchantId, branchId])
  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
}

model Space {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  name           String
  type           SpaceType
  customType     String?
  status         SpaceStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                Branch                   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments           SpaceAssignment[]
  agreementReservations MerchantAgreementSpace[]

  @@unique([organizationId, branchId, code])
  @@unique([id, branchId, organizationId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, name])
}

model SpaceAssignment {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  spaceId        String
  merchantId     String
  agreementId    String?
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  space     Space              @relation(fields: [spaceId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)
  merchant  Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  agreement MerchantAgreement? @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
  @@index([spaceId, startDate])
  @@index([organizationId, agreementId])
}

model MerchantAgreement {
  id                       String             @id @default(uuid())
  organizationId           String
  merchantId               String
  activationAt             DateTime           @db.Date
  draftSlot                Int?
  startDate                DateTime           @db.Date
  endDate                  DateTime?          @db.Date
  durationMonths           Int?
  activatedAt              DateTime?
  scheduledEndDate         DateTime?          @db.Date
  endedAt                  DateTime?
  endedById                String?
  endReason                String?
  submittedAt              DateTime?
  submittedById            String?
  approvedAt               DateTime?
  approvedById             String?
  returnedAt               DateTime?
  returnedById             String?
  returnReason             String?
  suspendedAt              DateTime?
  suspendedById            String?
  suspensionReason         String?
  lastActivationAttemptAt  DateTime?
  activationFailureReason  String?
  fixedRentAmount          Decimal?           @db.Decimal(12, 2)
  commissionRate           Decimal?           @db.Decimal(5, 2)
  securityDepositAmount    Decimal?           @db.Decimal(12, 2)
  firstRentPaymentRequired Boolean            @default(false)
  rentDueWeek              RentDueWeek?
  rentDueWeekday           RentDueWeekday?
  settlementSchedule       SettlementSchedule
  status                   AgreementStatus    @default(DRAFT)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant          Merchant                 @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlementTerms   SettlementTermSnapshot[]
  rentReceivables   MerchantReceivable[]
  financeAccruals   MerchantFinanceAccrual[]
  spaceReservations MerchantAgreementSpace[]
  spaceAssignments  SpaceAssignment[]
  prepayments       AgreementPrepayment[]

  @@unique([id, organizationId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, status])
}

model MerchantAgreementSpace {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  agreementId    String
  spaceId        String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreement    MerchantAgreement @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  space        Space             @relation(fields: [spaceId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)

  @@unique([agreementId, spaceId])
  @@index([organizationId, spaceId, periodStart, periodEnd])
  @@index([organizationId, agreementId, releasedAt])
}

model AgreementPrepayment {
  id             String                  @id @default(uuid())
  organizationId String
  merchantId     String
  agreementId    String
  kind           AgreementPrepaymentKind
  requiredAmount Decimal                 @db.Decimal(14, 2)
  appliedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant                         @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  agreement    MerchantAgreement                @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions AgreementPrepaymentTransaction[]

  @@unique([organizationId, agreementId, kind])
  @@unique([id, merchantId, organizationId])
  @@index([organizationId, merchantId, kind])
}

model AgreementPrepaymentTransaction {
  id              String                             @id @default(uuid())
  organizationId  String
  merchantId      String
  prepaymentId    String
  type            AgreementPrepaymentTransactionType
  amount          Decimal                            @db.Decimal(14, 2)
  paymentMethod   PaymentMethod?
  referenceNumber String?
  reason          String?
  requestId       String?
  occurredAt      DateTime                           @default(now())
  recordedById    String
  createdAt       DateTime                           @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant            @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  prepayment   AgreementPrepayment @relation(fields: [prepaymentId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  recordedBy   User                @relation("AgreementPrepaymentTransactionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, requestId])
  @@index([organizationId, prepaymentId, occurredAt])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  merchantId     String
  name           String
  sku            String
  barcode        String?
  sellingPrice   Decimal       @db.Decimal(12, 2)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant            @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    Inventory[]
  movements    InventoryMovement[]
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, name])
}

model Inventory {
  organizationId String
  branchId       String
  productId      String
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product             @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements    InventoryMovement[]

  @@id([productId, branchId, organizationId])
  @@index([organizationId, branchId, quantity])
  @@index([organizationId, productId])
}

model InventoryMovement {
  id             String                @id @default(uuid())
  organizationId String
  branchId       String
  productId      String
  quantityChange Int
  type           InventoryMovementType
  referenceId    String?
  note           String?
  createdById    String
  saleId         String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    Inventory    @relation(fields: [productId, branchId, organizationId], references: [productId, branchId, organizationId], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, productId, createdAt])
  @@index([createdById, createdAt])
  @@index([referenceId])
  @@index([saleId])
}

model Sale {
  id                  String     @id @default(uuid())
  organizationId      String
  branchId            String
  cashierId           String
  saleNumber          String
  clientTransactionId String
  subtotal            Decimal    @db.Decimal(14, 2)
  discountTotal       Decimal    @default(0) @db.Decimal(14, 2)
  total               Decimal    @db.Decimal(14, 2)
  status              SaleStatus @default(COMPLETED)
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  completedAt         DateTime   @default(now())
  createdAt           DateTime   @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cashier            User                @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  voidedBy           User?               @relation("SaleVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  refunds            SaleRefund[]

  @@unique([id, organizationId])
  @@unique([organizationId, saleNumber])
  @@unique([organizationId, clientTransactionId])
  @@index([organizationId, branchId, completedAt])
  @@index([organizationId, cashierId, completedAt])
  @@index([organizationId, completedAt])
}

model SaleItem {
  id             String  @id @default(uuid())
  organizationId String
  saleId         String
  productId      String
  merchantId     String
  productName    String
  productSku     String
  productBarcode String?
  merchantName   String
  quantity       Int
  unitPrice      Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale            Sale                 @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product         Product              @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merchant        Merchant             @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlementLinks SettlementSaleItem[]
  refundItems     SaleRefundItem[]

  @@unique([id, merchantId, organizationId])
  @@index([organizationId, merchantId, saleId])
  @@index([organizationId, productId, saleId])
  @@index([saleId])
}

model SaleRefund {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  saleId         String
  reason         String
  status         RefundStatus @default(COMPLETED)
  completedById  String
  completedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sale         Sale             @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  completedBy  User             @relation("RefundCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  items        SaleRefundItem[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, completedAt])
  @@index([organizationId, completedAt])
  @@index([saleId, completedAt])
}

model SaleRefundItem {
  id             String  @id @default(uuid())
  organizationId String
  refundId       String
  saleItemId     String
  merchantId     String
  quantity       Int
  amount         Decimal @db.Decimal(14, 2)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refund          SaleRefund             @relation(fields: [refundId, organizationId], references: [id, organizationId], onDelete: Restrict)
  saleItem        SaleItem               @relation(fields: [saleItemId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  merchant        Merchant               @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlementLinks SettlementRefundItem[]

  @@unique([id, merchantId, organizationId])
  @@index([organizationId, merchantId, refundId])
  @@index([saleItemId])
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  saleId          String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(14, 2)
  referenceNumber String?
  confirmedById   String
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  confirmedBy  User         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([organizationId, method, paidAt])
  @@index([saleId])
  @@index([confirmedById, paidAt])
}

model MerchantSettlement {
  id                 String             @id @default(uuid())
  organizationId     String
  merchantId         String
  periodStart        DateTime           @db.Date
  periodEnd          DateTime           @db.Date
  scheduledDeadline  DateTime?          @db.Date
  schedule           SettlementSchedule
  status             SettlementStatus   @default(DRAFT)
  grossSales         Decimal            @default(0) @db.Decimal(14, 2)
  refundTotal        Decimal            @default(0) @db.Decimal(14, 2)
  netSales           Decimal            @default(0) @db.Decimal(14, 2)
  commissionAmount   Decimal            @default(0) @db.Decimal(14, 2)
  fixedRentAmount    Decimal            @default(0) @db.Decimal(14, 2)
  adjustmentTotal    Decimal            @default(0) @db.Decimal(14, 2)
  netPayout          Decimal            @default(0) @db.Decimal(14, 2)
  calculatedById     String
  calculatedAt       DateTime           @default(now())
  reviewedById       String?
  reviewedAt         DateTime?
  approvedById       String?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  closureRequestId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization           Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant               Merchant                         @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  calculatedBy           User                             @relation("SettlementCalculator", fields: [calculatedById], references: [id], onDelete: Restrict)
  reviewedBy             User?                            @relation("SettlementReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  approvedBy             User?                            @relation("SettlementApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  terms                  SettlementTermSnapshot[]
  saleItems              SettlementSaleItem[]
  financeEntries         MerchantFinanceEntry[]           @relation("SettlementFinanceEntries")
  releasedFinanceEntries MerchantFinanceEntry[]           @relation("ReleasedSettlementFinanceEntries")
  payout                 MerchantPayout?
  refundItems            SettlementRefundItem[]
  auditEvents            SettlementAuditEvent[]
  receivableTransactions MerchantReceivableTransaction[]
  receivableAllocations  SettlementReceivableAllocation[]

  @@unique([id, organizationId])
  @@unique([id, merchantId, organizationId])
  @@unique([organizationId, merchantId, periodStart, periodEnd])
  @@unique([organizationId, closureRequestId])
  @@index([organizationId, status, periodEnd])
  @@index([organizationId, merchantId, periodEnd])
}

model SettlementRefundItem {
  settlementId   String
  refundItemId   String
  organizationId String
  merchantId     String
  refundAmount   Decimal   @db.Decimal(14, 2)
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  refundItem   SaleRefundItem     @relation(fields: [refundItemId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)

  @@id([settlementId, refundItemId])
  @@index([organizationId, merchantId, refundItemId])
  @@index([organizationId, merchantId, settlementId])
}

model SettlementAuditEvent {
  id             String                   @id @default(uuid())
  organizationId String
  settlementId   String
  actorId        String?
  type           SettlementAuditEventType
  reason         String?
  createdAt      DateTime                 @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlement   MerchantSettlement @relation(fields: [settlementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User?              @relation("SettlementAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, settlementId, createdAt])
}

model SettlementTermSnapshot {
  id               String             @id @default(uuid())
  organizationId   String
  merchantId       String
  settlementId     String
  agreementId      String
  segmentStart     DateTime           @db.Date
  segmentEnd       DateTime           @db.Date
  schedule         SettlementSchedule
  fixedRentRate    Decimal?           @db.Decimal(12, 2)
  commissionRate   Decimal?           @db.Decimal(5, 2)
  grossSales       Decimal            @default(0) @db.Decimal(14, 2)
  refundTotal      Decimal            @default(0) @db.Decimal(14, 2)
  netSales         Decimal            @default(0) @db.Decimal(14, 2)
  commissionAmount Decimal            @default(0) @db.Decimal(14, 2)
  createdAt        DateTime           @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant             @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement   @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  agreement    MerchantAgreement    @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  saleItems    SettlementSaleItem[]

  @@unique([id, settlementId, merchantId, organizationId])
  @@unique([settlementId, agreementId, segmentStart])
  @@index([organizationId, merchantId, segmentStart])
}

model SettlementSaleItem {
  settlementId   String
  termSnapshotId String
  saleItemId     String
  organizationId String
  merchantId     String
  grossAmount    Decimal   @db.Decimal(14, 2)
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant               @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement     @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  termSnapshot SettlementTermSnapshot @relation(fields: [termSnapshotId, settlementId, merchantId, organizationId], references: [id, settlementId, merchantId, organizationId], onDelete: Restrict)
  saleItem     SaleItem               @relation(fields: [saleItemId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)

  @@id([settlementId, saleItemId])
  @@index([organizationId, merchantId, saleItemId])
  @@index([organizationId, merchantId, settlementId])
  @@index([termSnapshotId])
}

model MerchantFinanceEntry {
  id                       String    @id @default(uuid())
  organizationId           String
  merchantId               String
  settlementId             String?
  releasedFromSettlementId String?
  voidedAt                 DateTime?
  voidedById               String?
  voidReason               String?
  amount                   Decimal   @db.Decimal(14, 2)
  reason                   String
  occurredAt               DateTime  @default(now())
  createdById              String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant               Merchant            @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement             MerchantSettlement? @relation("SettlementFinanceEntries", fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  releasedFromSettlement MerchantSettlement? @relation("ReleasedSettlementFinanceEntries", fields: [releasedFromSettlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  createdBy              User                @relation("MerchantFinanceEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, merchantId, settlementId])
  @@index([organizationId, merchantId, voidedAt])
  @@index([createdById, createdAt])
  @@map("SettlementAdjustment")
}

model MerchantFinanceAccrual {
  id               String                     @id @default(uuid())
  organizationId   String
  merchantId       String
  agreementId      String
  periodStart      DateTime                   @db.Date
  periodEnd        DateTime                   @db.Date
  schedule         SettlementSchedule
  kind             MerchantFinanceAccrualKind @default(EARNED_ACTIVITY)
  commissionRate   Decimal?                   @db.Decimal(5, 2)
  grossSales       Decimal                    @default(0) @db.Decimal(14, 2)
  refundTotal      Decimal                    @default(0) @db.Decimal(14, 2)
  commissionAmount Decimal                    @default(0) @db.Decimal(14, 2)
  revision         BigInt                     @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  agreement    MerchantAgreement @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, merchantId, agreementId, periodStart, periodEnd, kind], name: "bucket", map: "MerchantFinanceAccrual_bucket_key")
  @@index([organizationId, merchantId, periodEnd], map: "MerchantFinanceAccrual_merchant_period_idx")
  @@index([organizationId, periodEnd], map: "MerchantFinanceAccrual_organization_period_idx")
}

model MerchantReceivable {
  id              String                   @id @default(uuid())
  organizationId  String
  merchantId      String
  agreementId     String
  sourcePeriod    DateTime                 @db.Date
  periodStart     DateTime?                @db.Date
  periodEnd       DateTime?                @db.Date
  cycleNumber     Int?
  originalAmount  Decimal                  @db.Decimal(14, 2)
  remainingAmount Decimal                  @db.Decimal(14, 2)
  dueDate         DateTime                 @db.Date
  status          MerchantReceivableStatus @default(OPEN)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant                         @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  agreement    MerchantAgreement                @relation(fields: [agreementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions MerchantReceivableTransaction[]
  allocations  SettlementReceivableAllocation[]

  @@unique([id, merchantId, organizationId])
  @@unique([organizationId, agreementId, cycleNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, merchantId, sourcePeriod])
}

model MerchantReceivableTransaction {
  id              String                            @id @default(uuid())
  organizationId  String
  merchantId      String
  receivableId    String
  settlementId    String?
  type            MerchantReceivableTransactionType
  amount          Decimal                           @db.Decimal(14, 2)
  paymentMethod   PaymentMethod?
  referenceNumber String?
  note            String?
  requestId       String?
  occurredAt      DateTime                          @default(now())
  recordedById    String
  createdAt       DateTime                          @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant            @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  receivable   MerchantReceivable  @relation(fields: [receivableId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement? @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  recordedBy   User                @relation("MerchantReceivableTransactionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, requestId])
  @@index([organizationId, receivableId, occurredAt])
  @@index([organizationId, merchantId, occurredAt])
  @@index([settlementId])
  @@index([recordedById, occurredAt])
}

model SettlementReceivableAllocation {
  settlementId   String
  receivableId   String
  organizationId String
  merchantId     String
  amount         Decimal   @db.Decimal(14, 2)
  appliedAt      DateTime?
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  receivable   MerchantReceivable @relation(fields: [receivableId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)

  @@id([settlementId, receivableId])
  @@index([organizationId, merchantId, settlementId])
  @@index([organizationId, receivableId, appliedAt])
}

model MerchantPayout {
  id              String       @id @default(uuid())
  organizationId  String
  merchantId      String
  settlementId    String
  amount          Decimal      @db.Decimal(14, 2)
  method          PayoutMethod
  referenceNumber String?
  note            String?
  paidAt          DateTime
  recordedById    String
  createdAt       DateTime     @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  settlement   MerchantSettlement @relation(fields: [settlementId, merchantId, organizationId], references: [id, merchantId, organizationId], onDelete: Restrict)
  recordedBy   User               @relation("PayoutRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([settlementId, merchantId, organizationId])
  @@index([organizationId, merchantId, paidAt])
  @@index([organizationId, paidAt])
  @@index([recordedById, paidAt])
}

