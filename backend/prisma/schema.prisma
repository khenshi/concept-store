generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMemberships OrganizationMembership[]
  sessions                UserSession[]
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  branches    Branch[]
  merchants   Merchant[]
  spaces      Space[]
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String?
  countryCode    String   @db.Char(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchants    MerchantBranch[]
  spaces       Space[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Merchant {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String
  email          String
  phone          String
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches         MerchantBranch[]
  spaceAssignments SpaceAssignment[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model MerchantBranch {
  organizationId String
  merchantId     String
  branchId       String
  createdAt      DateTime @default(now())

  merchant         Merchant          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  spaceAssignments SpaceAssignment[]

  @@id([merchantId, branchId])
  @@unique([merchantId, branchId, organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
}

model Space {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  name           String
  type           SpaceType
  customType     String?
  status         SpaceStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments  SpaceAssignment[]

  @@unique([organizationId, branchId, code])
  @@unique([id, branchId, organizationId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, name])
}

model SpaceAssignment {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  spaceId        String
  merchantId     String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  space          Space          @relation(fields: [spaceId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)
  merchant       Merchant       @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merchantBranch MerchantBranch @relation(fields: [merchantId, branchId, organizationId], references: [merchantId, branchId, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
  @@index([spaceId, startDate])
}

enum OrganizationRole {
  OWNER
  MANAGER
  CASHIER
  MERCHANT
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ENDED
}

enum SpaceType {
  RACK
  SHELF
  CABINET
  BOOTH
  TABLE
  DRAWER
  CUSTOM
}

enum SpaceStatus {
  ACTIVE
  INACTIVE
}
