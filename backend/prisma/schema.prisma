generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  organizationMemberships         OrganizationMembership[]
  sentOrganizationInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  sessions                        UserSession[]
  inventoryMovements              InventoryMovement[]
  sales                           Sale[]
  refunds                         Refund[]
  openingStockProducts            Product[]                @relation("ProductCreationActor")

  @@index([deletedAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  branches    Branch[]
  invitations OrganizationInvitation[]
  merchants   Merchant[]
  products    Product[]
  sales       Sale[]
  refunds     Refund[]
}

model Merchant {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String
  email          String?
  phone          String
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  products    Product[]
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]

  saleItems   SaleItem[]
  refundItems RefundItem[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String?
  countryCode    String   @db.Char(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventory        BranchInventory[]
  memberships      BranchMembership[]
  invitationGrants InvitationBranch[]
  sales            Sale[]
  refunds          Refund[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model Product {
  id                String        @id @default(uuid())
  organizationId    String
  merchantId        String
  name              String
  sku               String?
  barcode           String?
  status            ProductStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  creationRequestId String?       @db.Uuid
  creationActorId   String?
  creationCommand   Json?         @db.JsonB
  creationActor     User?         @relation("ProductCreationActor", fields: [creationActorId], references: [id], onDelete: Restrict)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    BranchInventory[]
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, creationRequestId])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@unique([id, organizationId, merchantId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, name])
}

/// Quantity and price CHECK constraints are defined in the SQL migration.
model BranchInventory {
  id                String   @id @default(uuid())
  organizationId    String
  branchId          String
  productId         String
  sellingPrice      Decimal  @db.Decimal(12, 2)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch    Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product   Product             @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements InventoryMovement[]
  saleItems SaleItem[]

  @@unique([organizationId, branchId, productId])
  @@unique([id, organizationId, branchId])
  @@unique([id, organizationId, branchId, productId])
  @@index([organizationId, productId])
}

/// Delta, receipt, and resulting-quantity CHECK constraints are defined in SQL.
model InventoryMovement {
  id                String                @id @default(uuid())
  organizationId    String
  branchId          String
  branchInventoryId String
  type              InventoryMovementType
  quantityChange    Int
  quantityAfter     Int
  reason            String
  createdById       String
  requestId         String
  createdAt         DateTime              @default(now())
  saleItemId        String?
  refundItemId      String?

  inventory  BranchInventory @relation(fields: [branchInventoryId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  saleItem   SaleItem?       @relation(fields: [saleItemId, organizationId, branchId, branchInventoryId], references: [id, organizationId, branchId, branchInventoryId], onDelete: Restrict)
  refundItem RefundItem?     @relation(fields: [refundItemId, organizationId, branchId, branchInventoryId, quantityChange], references: [id, organizationId, branchId, branchInventoryId, restockQuantity], onDelete: Restrict, onUpdate: Restrict, map: "InventoryMovement_refundItem_scope_fkey")

  @@unique([organizationId, requestId])
  @@unique([saleItemId, organizationId, branchId, branchInventoryId], map: "InventoryMovement_saleItem_scope_key")
  @@unique([refundItemId, organizationId, branchId, branchInventoryId, quantityChange], map: "InventoryMovement_refundItem_scope_key")
  @@index([organizationId, branchId, branchInventoryId, createdAt, id], map: "InventoryMovement_history_idx")
}

/// Completed-only records. Payment/amount constraints are defined in SQL.
model Sale {
  id               String            @id @default(uuid())
  organizationId   String
  branchId         String
  receiptCode      String
  createdById      String
  requestId        String
  paymentMethod    SalePaymentMethod
  cashTender       Decimal?          @db.Decimal(24, 2)
  cashChange       Decimal?          @db.Decimal(24, 2)
  paymentReference String?
  total            Decimal           @db.Decimal(24, 2)
  completedAt      DateTime          @default(now())
  organizationName String
  branchName       String
  branchCode       String?
  cashierName      String
  checkoutCommand  Json              @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        SaleItem[]
  refunds      Refund[]

  @@unique([organizationId, receiptCode])
  @@unique([organizationId, requestId])
  @@unique([id, organizationId, branchId])
  @@index([organizationId, branchId, completedAt, id], map: "Sale_branch_history_idx")
  @@index([organizationId, branchId, createdById, completedAt, id], map: "Sale_cashier_history_idx")
}

/// Snapshot amounts/quantity checks are defined in SQL. No item mutation API.
model SaleItem {
  id                String  @id @default(uuid())
  organizationId    String
  branchId          String
  saleId            String
  branchInventoryId String
  productId         String
  merchantId        String
  quantity          Int
  productName       String
  sku               String?
  barcode           String?
  merchantName      String
  unitPrice         Decimal @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(22, 2)

  sale        Sale               @relation(fields: [saleId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  inventory   BranchInventory    @relation(fields: [branchInventoryId, organizationId, branchId, productId], references: [id, organizationId, branchId, productId], onDelete: Restrict)
  product     Product            @relation(fields: [productId, organizationId, merchantId], references: [id, organizationId, merchantId], onDelete: Restrict)
  merchant    Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement    InventoryMovement?
  refundItems RefundItem[]

  @@unique([saleId, branchInventoryId])
  @@unique([id, organizationId, branchId, branchInventoryId], map: "SaleItem_inventory_scope_key")
  @@unique([id, organizationId, branchId, saleId, branchInventoryId, merchantId, unitPrice], map: "SaleItem_refund_source_key")
  @@index([organizationId, merchantId, branchId, saleId], map: "SaleItem_merchant_sales_idx")
}

/// Completed-only manual refund records. Row-local payment checks are defined in SQL.
model Refund {
  id               String            @id @default(uuid())
  organizationId   String
  branchId         String
  saleId           String
  refundCode       String
  requestId        String            @db.Uuid
  createdById      String
  completedAt      DateTime          @default(now())
  reason           String
  paymentMethod    SalePaymentMethod
  paymentReference String?
  total            Decimal           @db.Decimal(24, 2)
  refundCommand    Json              @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sale         Sale         @relation(fields: [saleId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict, onUpdate: Restrict, map: "Refund_sale_scope_fkey")
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        RefundItem[]

  @@unique([organizationId, refundCode])
  @@unique([organizationId, requestId])
  @@unique([id, organizationId, branchId, saleId], map: "Refund_sale_scope_key")
  @@index([organizationId, branchId, saleId, completedAt, id], map: "Refund_sale_history_idx")
  @@index([organizationId, branchId, completedAt, id], map: "Refund_branch_reports_idx")
}

/// Original source price and placement are enforced by a composite foreign key.
model RefundItem {
  id                String  @id @default(uuid())
  organizationId    String
  branchId          String
  saleId            String
  refundId          String
  saleItemId        String
  branchInventoryId String
  merchantId        String
  quantity          Int
  restockQuantity   Int     @default(0)
  unitPrice         Decimal @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(22, 2)

  refund   Refund             @relation(fields: [refundId, organizationId, branchId, saleId], references: [id, organizationId, branchId, saleId], onDelete: Restrict, onUpdate: Restrict, map: "RefundItem_refund_scope_fkey")
  saleItem SaleItem           @relation(fields: [saleItemId, organizationId, branchId, saleId, branchInventoryId, merchantId, unitPrice], references: [id, organizationId, branchId, saleId, branchInventoryId, merchantId, unitPrice], onDelete: Restrict, onUpdate: Restrict, map: "RefundItem_saleItem_source_fkey")
  merchant Merchant           @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement InventoryMovement?

  @@unique([refundId, saleItemId])
  @@unique([id, organizationId, branchId, branchInventoryId, restockQuantity], map: "RefundItem_movement_scope_key")
  @@index([organizationId, branchId, saleId, saleItemId], map: "RefundItem_returned_quantity_idx")
  @@index([organizationId, merchantId, branchId, refundId], map: "RefundItem_merchant_refunds_idx")
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole
  merchantId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     Merchant?          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branches     BranchMembership[]

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, merchantId])
}

model BranchMembership {
  organizationId String
  branchId       String
  userId         String
  createdAt      DateTime @default(now())

  branch     Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([organizationId, branchId, userId])
  @@index([organizationId, userId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  merchantId     String?
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  acceptedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User               @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?              @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)
  merchant     Merchant?          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branches     InvitationBranch[]

  @@unique([id, organizationId])
  @@index([organizationId, merchantId])
  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model InvitationBranch {
  invitationId   String
  organizationId String
  branchId       String

  invitation OrganizationInvitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch     Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([invitationId, branchId])
  @@index([branchId, organizationId])
}

enum OrganizationRole {
  OWNER
  MANAGER
  CASHIER
  MERCHANT
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  SALE
  RETURN
}

enum SalePaymentMethod {
  CASH
  GCASH
  CARD
}
