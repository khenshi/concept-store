generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  organizationMemberships         OrganizationMembership[]
  sentOrganizationInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  sessions                        UserSession[]
  inventoryMovements              InventoryMovement[]

  @@index([deletedAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  branches    Branch[]
  invitations OrganizationInvitation[]
  merchants   Merchant[]
  products    Product[]
}

model Merchant {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String
  email          String?
  phone          String
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  products Product[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String?
  countryCode    String   @db.Char(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventory    BranchInventory[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  merchantId     String
  name           String
  sku            String?
  barcode        String?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant          @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    BranchInventory[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, name])
}

/// Quantity and price CHECK constraints are defined in the SQL migration.
model BranchInventory {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  productId      String
  sellingPrice   Decimal  @db.Decimal(12, 2)
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch    Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product   Product             @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements InventoryMovement[]

  @@unique([organizationId, branchId, productId])
  @@unique([id, organizationId, branchId])
  @@index([organizationId, productId])
}

/// Delta, receipt, and resulting-quantity CHECK constraints are defined in SQL.
model InventoryMovement {
  id                String                @id @default(uuid())
  organizationId    String
  branchId          String
  branchInventoryId String
  type              InventoryMovementType
  quantityChange    Int
  quantityAfter     Int
  reason            String
  createdById       String
  requestId         String
  createdAt         DateTime              @default(now())

  inventory BranchInventory @relation(fields: [branchInventoryId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestId])
  @@index([organizationId, branchId, branchInventoryId, createdAt, id], map: "InventoryMovement_history_idx")
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  acceptedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

enum OrganizationRole {
  OWNER
  MANAGER
  CASHIER
  MERCHANT
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
}
