generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  organizationMemberships         OrganizationMembership[]
  sentOrganizationInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  sessions                        UserSession[]
  inventoryMovements              InventoryMovement[]
  salesAsCashier                  Sale[]                   @relation("SaleCashier")
  confirmedPayments               Payment[]                @relation("PaymentConfirmer")

  @@index([deletedAt])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  acceptedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        OrganizationMembership[]
  branches           Branch[]
  merchants          Merchant[]
  spaces             Space[]
  merchantAgreements MerchantAgreement[]
  products           Product[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  invitations        OrganizationInvitation[]
  sales              Sale[]
  saleItems          SaleItem[]
  payments           Payment[]
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String?
  countryCode    String   @db.Char(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchants    MerchantBranch[]
  spaces       Space[]
  inventory    Inventory[]
  movements    InventoryMovement[]
  sales        Sale[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Merchant {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String
  email          String
  phone          String
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches         MerchantBranch[]
  spaceAssignments SpaceAssignment[]
  agreements       MerchantAgreement[]
  products         Product[]
  saleItems        SaleItem[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model MerchantBranch {
  organizationId String
  merchantId     String
  branchId       String
  createdAt      DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([merchantId, branchId])
  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
}

model Space {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  name           String
  type           SpaceType
  customType     String?
  status         SpaceStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments  SpaceAssignment[]

  @@unique([organizationId, branchId, code])
  @@unique([id, branchId, organizationId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, name])
}

model SpaceAssignment {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  spaceId        String
  merchantId     String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  space    Space    @relation(fields: [spaceId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId])
  @@index([organizationId, merchantId])
  @@index([spaceId, startDate])
}

model MerchantAgreement {
  id                 String             @id @default(uuid())
  organizationId     String
  merchantId         String
  startDate          DateTime           @db.Date
  endDate            DateTime?          @db.Date
  fixedRentAmount    Decimal?           @db.Decimal(12, 2)
  commissionRate     Decimal?           @db.Decimal(5, 2)
  settlementSchedule SettlementSchedule
  status             AgreementStatus    @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant     @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, status])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  merchantId     String
  name           String
  sku            String
  barcode        String?
  sellingPrice   Decimal       @db.Decimal(12, 2)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchant     Merchant            @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    Inventory[]
  movements    InventoryMovement[]
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@index([organizationId, merchantId, status])
  @@index([organizationId, name])
}

model Inventory {
  organizationId String
  branchId       String
  productId      String
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product             @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements    InventoryMovement[]

  @@id([productId, branchId, organizationId])
  @@index([organizationId, branchId, quantity])
  @@index([organizationId, productId])
}

model InventoryMovement {
  id             String                @id @default(uuid())
  organizationId String
  branchId       String
  productId      String
  quantityChange Int
  type           InventoryMovementType
  referenceId    String?
  note           String?
  createdById    String
  saleId         String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventory    Inventory    @relation(fields: [productId, branchId, organizationId], references: [productId, branchId, organizationId], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, productId, createdAt])
  @@index([createdById, createdAt])
  @@index([referenceId])
  @@index([saleId])
}

model Sale {
  id                  String   @id @default(uuid())
  organizationId      String
  branchId            String
  cashierId           String
  saleNumber          String
  clientTransactionId String
  subtotal            Decimal  @db.Decimal(14, 2)
  discountTotal       Decimal  @default(0) @db.Decimal(14, 2)
  total               Decimal  @db.Decimal(14, 2)
  completedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cashier            User                @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]

  @@unique([id, organizationId])
  @@unique([organizationId, saleNumber])
  @@unique([organizationId, clientTransactionId])
  @@index([organizationId, branchId, completedAt])
  @@index([organizationId, cashierId, completedAt])
}

model SaleItem {
  id             String  @id @default(uuid())
  organizationId String
  saleId         String
  productId      String
  merchantId     String
  productName    String
  productSku     String
  productBarcode String?
  merchantName   String
  quantity       Int
  unitPrice      Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merchant     Merchant     @relation(fields: [merchantId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, merchantId, saleId])
  @@index([organizationId, productId, saleId])
  @@index([saleId])
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  saleId          String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(14, 2)
  referenceNumber String?
  confirmedById   String
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  confirmedBy  User         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([organizationId, method, paidAt])
  @@index([saleId])
  @@index([confirmedById, paidAt])
}

enum OrganizationRole {
  OWNER
  MANAGER
  CASHIER
  MERCHANT
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ENDED
}

enum SpaceType {
  RACK
  SHELF
  CABINET
  BOOTH
  TABLE
  DRAWER
  CUSTOM
}

enum SpaceStatus {
  ACTIVE
  INACTIVE
}

enum SettlementSchedule {
  WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  STOCK_IN
  ADJUSTMENT
  SALE
}

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  OTHER
}
